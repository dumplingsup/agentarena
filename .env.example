# Copy to .env. Credentials stay on the server.
ARENA_PROVIDER=openai
ARENA_MODEL=gpt-4.1-mini
ARENA_API_KEY=
# Optional OpenAI-compatible endpoint (uses Pi openai-completions adapter)
ARENA_BASE_URL=
ARENA_THINKING=off
ARENA_TIMEOUT_MS=20000
ARENA_MAX_TOKENS=500
ARENA_MATCH_TOKENS=200000
PORT=3000
